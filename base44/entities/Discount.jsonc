{
  "name": "Discount",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data do desconto"
    },
    "type": {
      "type": "string",
      "description": "Tipo de desconto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do desconto"
    },
    "value": {
      "type": "number",
      "description": "Valor do desconto em euros ou porcentagem"
    },
    "isPercentage": {
      "type": "boolean",
      "default": false,
      "description": "Se verdadeiro, o valor \u00e9 uma porcentagem; se falso, \u00e9 um valor fixo"
    }
  },
  "required": [
    "date",
    "type",
    "description",
    "value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "clauorenstein@yahoo.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "clauorenstein@yahoo.com"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}