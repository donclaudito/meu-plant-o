{
  "name": "ExtraIncome",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da receita"
    },
    "doctorName": {
      "type": "string",
      "description": "Nome do m\u00e9dico respons\u00e1vel"
    },
    "type": {
      "type": "string",
      "enum": [
        "Consulta SUS",
        "Cirurgia CO",
        "Ambulat\u00f3rio",
        "Cirurgia",
        "B\u00f4nus",
        "Aposentadoria",
        "Outro"
      ],
      "description": "Tipo de receita extra"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da receita"
    },
    "value": {
      "type": "number",
      "description": "Valor em reais"
    }
  },
  "required": [
    "date",
    "doctorName",
    "type",
    "value"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}